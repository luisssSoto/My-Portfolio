<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Web Application</title>
</head>
<body>
    <header>
        <%- include("partials/header.ejs") %>
    </header>
    <button id="createPost">Create New Post</button>
    <br><br>
    <div id="showingPostArea">
        <ul>
            <% posts.forEach(post => {%>
                <% let section = post.section;%>
                <% let postTitle = post.postTitle;%>
                <% let postDescription = post.postDescription;%>
                <% console.log(`section: ${section}
                postTitle: ${postTitle}
                postDescription: ${postDescription}`) %>
                <li class="postLi">
                    <p>
                        <%= section %>
                    </p>
                    <p>
                        <%= postTitle %>
                    </p>
                    <p>
                        <%= postDescription %>
                    </p>
                    <button class="editButton">Edit</button>
                </li>
                <% });%>
        </ul>
        <% if (locals.category && locals.title && locals.description) { %>
            <h3>
                <%= category %>
            </h3>
            <h3>
                <%= title %>
            </h3>
            <p>
                <%= description %>
            </p>
        <% } %>    
    </div>
    <script>
        const createButton = document.getElementById("createPost");
        createButton.addEventListener("click", function() {
            window.location.href = "../form";
                });

        const editButtons = document.getElementsByClassName("editButton");
        const arrayButtons = Array.from(editButtons);
        for (let i = 0; i < arrayButtons.length; i++) {
            const btn = arrayButtons[i];
            let postTitle = document.getElementsByClassName("postLi")[i].children[1].textContent.trim();
            btn.addEventListener("click", () => {
                window.location.href = `/edit?title=${encodeURIComponent(postTitle)}`;
            });
        };
    </script>
    <footer>
        <%- include("partials/footer.ejs") %>
    </footer>
</body>
</html>